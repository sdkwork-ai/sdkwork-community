# cloud.demo — cloud independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema/user `sdkwork_community_demo`
# and a dedicated Redis logical DB index so no cache key ever collides with another shared-redis environment.
SDKWORK_COMMUNITY_DEPLOYMENT_PROFILE=cloud
SDKWORK_COMMUNITY_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_COMMUNITY_PROFILE_ID=cloud.demo
SDKWORK_COMMUNITY_APPLICATION_PUBLIC_HTTP_URL=https://community-demo.sdkwork.com
SDKWORK_COMMUNITY_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com
SDKWORK_COMMUNITY_WEB_DEV_INGRESS_BIND=127.0.0.1:5129
SDKWORK_COMMUNITY_PC_INTERNAL_DEV_PORT=5131
SDKWORK_COMMUNITY_H5_INTERNAL_DEV_PORT=5132


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_COMMUNITY_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_CORS_ALLOWED_ORIGINS=https://community-demo.sdkwork.com,http://community-demo.sdkwork.com,https://community-demo.birdcoder.com,http://community-demo.birdcoder.com,https://community-demo.dtupay.com,http://community-demo.dtupay.com,https://community-demo.noaper.com,http://community-demo.noaper.com,https://community-demo.sdkwork.cn,http://community-demo.sdkwork.cn,https://community-demo.birdcoder.cn,http://community-demo.birdcoder.cn,https://community-demo.dtupay.cn,http://community-demo.dtupay.cn,https://community-demo.noaper.cn,http://community-demo.noaper.cn,https://community-demo.skubc.com,http://community-demo.skubc.com,https://community-demo.skubc.cn,http://community-demo.skubc.cn,https://community-demo.zowalk.com,http://community-demo.zowalk.com,https://community-demo.zowalk.cn,http://community-demo.zowalk.cn,https://community-demo.offer86.com,http://community-demo.offer86.com,https://community-demo.offer86.cn,http://community-demo.offer86.cn,https://community-demo.86offer.com,http://community-demo.86offer.com,https://community-demo.86offer.cn,http://community-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
