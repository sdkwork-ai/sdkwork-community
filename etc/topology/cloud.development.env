# Remote development APIs; sdkwork-app must not autostart cloud services for this profile.
SDKWORK_ENVIRONMENT=development
SDKWORK_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5129,http://localhost:5129,https://community-dev.sdkwork.com,http://community-dev.sdkwork.com,https://community-dev.birdcoder.com,http://community-dev.birdcoder.com,https://community-dev.dtupay.com,http://community-dev.dtupay.com,https://community-dev.noaper.com,http://community-dev.noaper.com,https://community-dev.sdkwork.cn,http://community-dev.sdkwork.cn,https://community-dev.birdcoder.cn,http://community-dev.birdcoder.cn,https://community-dev.dtupay.cn,http://community-dev.dtupay.cn,https://community-dev.noaper.cn,http://community-dev.noaper.cn,https://community-dev.skubc.com,http://community-dev.skubc.com,https://community-dev.skubc.cn,http://community-dev.skubc.cn,https://community-dev.zowalk.com,http://community-dev.zowalk.com,https://community-dev.zowalk.cn,http://community-dev.zowalk.cn,https://community-dev.offer86.com,http://community-dev.offer86.com,https://community-dev.offer86.cn,http://community-dev.offer86.cn,https://community-dev.86offer.com,http://community-dev.86offer.com,https://community-dev.86offer.cn,http://community-dev.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
SDKWORK_DEPLOYMENT_PROFILE=cloud
SDKWORK_PROFILE_ID=cloud.development
SDKWORK_RUNTIME_TARGET=browser
SDKWORK_COMMUNITY_ENVIRONMENT=development
SDKWORK_COMMUNITY_DEPLOYMENT_PROFILE=cloud
SDKWORK_COMMUNITY_PROFILE_ID=cloud.development
SDKWORK_COMMUNITY_RUNTIME_TARGET=browser

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_COMMUNITY_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_COMMUNITY_APPLICATION_PUBLIC_HTTP_URL=https://api-dev.sdkwork.com
SDKWORK_COMMUNITY_PLATFORM_API_GATEWAY_HTTP_URL=https://api-dev.sdkwork.com
VITE_SDKWORK_COMMUNITY_ENVIRONMENT=development
VITE_SDKWORK_COMMUNITY_DEPLOYMENT_PROFILE=cloud
VITE_SDKWORK_COMMUNITY_PROFILE_ID=cloud.development
VITE_SDKWORK_COMMUNITY_RUNTIME_TARGET=browser
VITE_SDKWORK_COMMUNITY_APPLICATION_PUBLIC_HTTP_URL=https://api-dev.sdkwork.com
VITE_SDKWORK_COMMUNITY_PLATFORM_API_GATEWAY_HTTP_URL=https://api-dev.sdkwork.com

VITE_SDKWORK_COMMUNITY_H5_FEEDS_OPEN_API_BASE_URL=https://api-dev.sdkwork.com
VITE_SDKWORK_COMMUNITY_PC_FEEDS_OPEN_API_BASE_URL=https://api-dev.sdkwork.com
SDKWORK_COMMUNITY_WEB_DEV_INGRESS_BIND=127.0.0.1:5129
SDKWORK_COMMUNITY_PC_INTERNAL_DEV_PORT=5131
SDKWORK_COMMUNITY_H5_INTERNAL_DEV_PORT=5132


# dev:cloud local debugging override (vite dev surface only; PNPM_SCRIPT_SPEC section 3).
# The domain edges above stay authoritative for cloud-mode builds and deployed
# services. The development runtime instead binds every gateway-attached base
# URL to the sdkwork-api-cloud-gateway started by its own dev command
# (bind 127.0.0.1:3900), so dev:cloud quick-starts and debugs against the
# local gateway process.
SDKWORK_LOCAL_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
