# Bootstrap profile cloud.staging — replace with application-specific values.
SDKWORK_COMMUNITY_DEPLOYMENT_PROFILE=cloud
SDKWORK_COMMUNITY_ENVIRONMENT=staging
SDKWORK_COMMUNITY_PROFILE_ID=cloud.staging
SDKWORK_COMMUNITY_APPLICATION_PUBLIC_HTTP_URL=https://community-staging.sdkwork.com
SDKWORK_COMMUNITY_PLATFORM_API_GATEWAY_HTTP_URL=https://api-staging.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_COMMUNITY_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

