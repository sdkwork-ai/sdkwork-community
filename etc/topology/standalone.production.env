# Single-host production profile. Operators may override safe values at install time.
SDKWORK_ENVIRONMENT=production
SDKWORK_DEPLOYMENT_PROFILE=standalone
SDKWORK_PROFILE_ID=standalone.production
SDKWORK_RUNTIME_TARGET=server
SDKWORK_COMMUNITY_ENVIRONMENT=production
SDKWORK_COMMUNITY_DEPLOYMENT_PROFILE=standalone
SDKWORK_COMMUNITY_PROFILE_ID=standalone.production
SDKWORK_COMMUNITY_RUNTIME_TARGET=server

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_COMMUNITY_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_COMMUNITY_SERVER_BIND=0.0.0.0:18094
SDKWORK_COMMUNITY_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18094
SDKWORK_CORS_ALLOWED_ORIGINS=http://127.0.0.1:18094,https://community.sdkwork.com,https://community.birdcoder.com,https://community.dtupay.com,https://community.noaper.com,https://community.sdkwork.cn,https://community.birdcoder.cn,https://community.dtupay.cn,https://community.noaper.cn,https://community.skubc.com,https://community.skubc.cn,https://community.zowalk.com,https://community.zowalk.cn,https://community.offer86.com,https://community.offer86.cn,https://community.86offer.com,https://community.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com

SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=127.0.0.1
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_prod
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_prod
SDKWORK_DATABASE_USERNAME=sdkwork_ai_prod
SDKWORK_DATABASE_PASSWORD_FILE=/run/secrets/sdkwork/community/database-password
SDKWORK_DATABASE_SSL_MODE=require
SDKWORK_DATABASE_MAX_CONNECTIONS=32

SDKWORK_COMMUNITY_REDIS_ENABLED=true
SDKWORK_COMMUNITY_REDIS_HOST=127.0.0.1
SDKWORK_COMMUNITY_REDIS_PORT=6379
SDKWORK_COMMUNITY_REDIS_DATABASE=0
SDKWORK_COMMUNITY_REDIS_PASSWORD_FILE=/run/secrets/sdkwork/community/redis-password
SDKWORK_COMMUNITY_REDIS_KEY_PREFIX=sdkwork:community
SDKWORK_COMMUNITY_REDIS_TLS=false

VITE_SDKWORK_COMMUNITY_H5_FEEDS_OPEN_API_BASE_URL=http://127.0.0.1:18095
VITE_SDKWORK_COMMUNITY_PC_FEEDS_OPEN_API_BASE_URL=http://127.0.0.1:18095
VITE_SDKWORK_COMMUNITY_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18094
SDKWORK_COMMUNITY_PC_STATIC_ROOT=/usr/share/sdkwork/community/web/pc
